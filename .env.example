# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Required. Get one from https://console.groq.com — the agents will not start without it.
GROQ_API_KEY=gsk_your_key_here

# Required in production. Encrypts stored SSH credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# If this is unset the app still boots, but falls back to a fixed development key —
# which means stored credentials are effectively not protected. The health endpoint
# reports which one is in use, so this is visible rather than silent.
ITOPS_SECRET_KEY=

# The address agents phone home to. Defaults to http://localhost:8000, which only
# works when the agent runs on the same machine as this server. Set it to the
# reachable address of this server before enrolling any remote host.
ITOPS_PUBLIC_URL=http://localhost:8000
